    {
      "id": "pillar-a-project",
      "type": "project",
      "text": "Employer Hub for an education provider",
      "value": "Designed so that employer partners get one front door and a faster answer, departments stop duplicating outreach and see each other's work with a partner, and leadership can report on the employer relationship as a whole.",
      "solution": "A working Employer Hub demo built on Salesforce. Every inquiry is captured once from a web form, matched to the partner's account and routed by the employer's industry. Service requests are fulfilled from the case, and monetary requests run through an opportunity to a contract. Operations and executive dashboards report from the same records.",
      "tags": [],
      "priority": 2,
      "verified": true,
      "visibility": "public"
    },
    {
      "id": "home-case-a",
      "type": "project",
      "text": "Home case study A",
      "value": "Designed so that employer partners get one front door and a faster answer, departments stop duplicating outreach and see each other's work with a partner, and leadership can report on the employer relationship as a whole.",
      "solution": "A working Employer Hub demo built on Salesforce. Every inquiry is captured once from a web form, matched to the partner's account and routed by the employer's industry. Service requests are fulfilled from the case, and monetary requests run through an opportunity to a contract. Operations and executive dashboards report from the same records.",
      "tags": [],
      "priority": 2,
      "verified": true,
      "visibility": "public"
    },
    {
      "id": "home-case-b",
      "type": "project",
      "text": "Home case study B",
      "value": "Ten staff users on donated licences, with staff testing the build in user acceptance before production.",
      "solution": "Advised against Education Cloud, which is built and priced for large institutions. Chose donated Sales and Service licences with free NPSP and Program Management over Nonprofit Cloud, for a cheaper path past ten seats. Left donations where they already ran.",
      "tags": [],
      "priority": 2,
      "verified": true,
      "visibility": "public"
    },
    {
      "id": "home-case-e",
      "type": "project",
      "text": "Home case study E",
      "value": "The test count on this card and the checklist on the Delivery page come from those stored runs, so they change when the pipeline does. A reviewer sees the roadmap, the commits and the latest pipeline results on one page.",
      "solution": "This site is its own delivery evidence. Every pull request is validated in a fresh scratch org with the local Apex tests and static analysis, and every merge that changes the app deploys to production through GitHub Actions and runs the local tests. Each run publishes a governance event that is stored as a pipeline run record. The Delivery page shows the latest run per workflow, the Jira roadmap and the recent commits, read from caches that scheduled jobs refresh.",
      "tags": [],
      "priority": 2,
      "verified": true,
      "visibility": "public"
    },
