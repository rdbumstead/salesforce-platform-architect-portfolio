{
  "name": "ryanbumstead-static-site",
  "private": true,
  "version": "0.1.0",
  "description": "Static front end for ryanbumstead.com, built from the Salesforce components and data at build time.",
  "type": "module",
  "scripts": {
    "export": "node build/export.mjs",
    "build": "node build/build.mjs",
    "build:fixtures": "node build/build.mjs --fixtures",
    "dev": "node build/build.mjs --fixtures && wrangler pages dev dist",
    "test": "node --test \"test/**/*.test.mjs\"",
    "coverage:check": "node build/check-export-coverage.mjs",
    "leak:scan": "node build/leak-scan.mjs dist"
  },
  "devDependencies": {
    "@lwc/rollup-plugin": "9.5.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "1.0.2",
    "lwc": "9.5.3",
    "pdfjs-dist": "6.5.438",
    "rollup": "4.67.4",
    "wrangler": "4.156.2"
  }
}
