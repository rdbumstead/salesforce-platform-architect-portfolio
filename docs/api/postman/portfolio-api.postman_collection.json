        {
          "name": "POST /auth/token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-API-Version",
                "value": "v1"
              },
              {
                "key": "X-Request-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{siteUrl}}/services/apexrest/papi/v1/auth/token",
              "host": ["{{siteUrl}}"],
              "path": ["services", "apexrest", "papi", "v1", "auth", "token"],
              "query": []
            },
            "description": "Request an evaluator access token",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"reviewer@example.com\",\n  \"purpose\": \"Evaluating API contract parity\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Keeps the token and instance URL for the other requests.",
                  "const body = pm.response.json();",
                  "if (body.access_token) {",
                  "  pm.collectionVariables.set(\"accessToken\", body.access_token);",
                  "  pm.collectionVariables.set(\"instanceUrl\", body.instance_url);",
                  "}"
                ]
              }
            }
          ]
        },
