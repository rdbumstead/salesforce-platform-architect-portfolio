{
  "name": "salesforce-platform-architect-portfolio",
  "private": true,
  "version": "1.0.0",
  "description": "Salesforce Platform Architect Portfolio",
  "scripts": {
    "prepare": "husky || true",
    "precommit": "lint-staged --config config/.lintstagedrc.json --concurrent false",
    "setup:plugins": "sf plugins install @salesforce/plugin-code-analyzer sfdx-git-delta",
    "pre-launch-check": "node scripts/pre-launch-check.js",
    "lint": "eslint \"**/{aura,lwc}/**/*.js\" --config config/eslint.config.mjs",
    "prettier": "prettier --config config/.prettierrc --write \"**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}\"",
    "prettier:verify": "prettier --config config/.prettierrc --check \"**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}\"",
    "scan:secrets": "secretlint --secretlintrc config/.secretlintrc.json --secretlintignore config/.secretlintignore --maskSecrets \"packages/**/*.{cls,trigger,js,xml,yaml,yml}\" \"docs/**/*.md\" \"scripts/**/*.js\"",
    "scan": "sf code-analyzer run --config-file config/code-analyzer.yml --target packages --output-file scan-results.html --severity-threshold 2",
    "scan:security": "snyk test",
    "test": "npm run test:unit",
    "test:unit": "sfdx-lwc-jest",
    "test:unit:watch": "sfdx-lwc-jest --watch",
    "test:unit:debug": "sfdx-lwc-jest --debug",
    "test:unit:coverage": "sfdx-lwc-jest --coverage",
    "test:lighthouse": "lhci autorun --config=./config/lighthouserc.cjs",
    "sf:coverage": "node scripts/coverage-gate.js",
    "sf:validate": "sf project deploy validate --source-dir packages --test-level RunLocalTests",
    "clean": "shx rm -rf changed",
    "delta": "npm run clean && shx mkdir -p changed && sf sgd source delta --to HEAD --from origin/main -o changed -s packages --generate-delta",
    "delta:validate": "node scripts/validate.js",
    "ci:local": "node scripts/ci-local.js",
    "docs:api": "node scripts/generate-api-docs.js",
    "docs:counts": "node scripts/check-doc-counts.js",
    "test:groups": "node scripts/count-test-groups.js",
    "test:groups:check": "node scripts/count-test-groups.js --check",
    "docs:mermaid-alt": "node scripts/check-mermaid-alt.js",
    "refs:check": "node scripts/check-internal-refs.js packages docs README.md STATUS.md",
    "specs:sync": "node scripts/sync-specs.js",
    "specs:check": "node scripts/sync-specs.js --check",
    "docs:verify": "npm run docs:api && git diff --exit-code docs/api/oas/ && echo \"SUCCESS: API Documentation is synchronized.\"",
    "web:install": "npm ci --prefix web",
    "web:build": "npm run build --prefix web",
    "web:dev": "npm run dev --prefix web",
    "web:test": "npm test --prefix web && node web/build/check-export-coverage.mjs"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@lhci/cli": "^0.15.1",
    "@lwc/eslint-plugin-lwc": "^3.3.0",
    "@prettier/plugin-xml": "^3.4.1",
    "@salesforce/eslint-config-lwc": "^4.1.1",
    "@salesforce/eslint-plugin-aura": "^3.0.0",
    "@salesforce/eslint-plugin-lightning": "^2.0.0",
    "@salesforce/sfdx-lwc-jest": "^7.9.0",
    "@secretlint/secretlint-rule-pattern": "^13.1.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
    "axe-core": "4.11.1",
    "eslint": "^9.29.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^29.0.1",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "js-yaml": "4.3.2",
    "lint-staged": "^16.1.2",
    "openapi-to-postmanv2": "6.4.0",
    "openapi-types": "^12.1.3",
    "prettier": "^3.5.3",
    "prettier-plugin-apex": "^2.2.6",
    "secretlint": "^13.1.0",
    "shx": "^0.4.0",
    "snyk": "^1.1301.2",
    "widdershins": "^4.0.1"
  },
  "overrides": {
    "@babel/core@<7.29.6": "^7.29.7",
    "basic-ftp@<6.2.1": "^6.2.5",
    "fast-xml-parser@<5.12.0": "^5.12.0",
    "form-data@>=3.0.0 <3.0.5": "^3.0.5",
    "minimatch@>=7.0.0 <11.0.1": "^11.0.8",
    "picomatch@<2.3.2": "^2.3.2",
    "tmp@<0.2.6": "^0.2.6",
    "uuid@<11.1.1": "^11.1.1",
    "yaml@>=1.0.0 <1.10.3": "^1.10.3",
    "openapi-to-postmanv2": {
      "js-yaml": "4.3.2"
    },
    "widdershins": {
      "markdown-it": "^14.3.3",
      "swagger2openapi": "^7.0.8",
      "yargs-parser": "^13.1.2"
    }
  }
}
