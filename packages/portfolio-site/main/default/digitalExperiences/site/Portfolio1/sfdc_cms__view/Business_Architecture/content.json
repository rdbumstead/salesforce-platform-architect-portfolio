                    {
                      "attributes": {
                        "imageInfos": "",
                        "richTextValue": "<h1>Business Architecture</h1><p>A community college had several departments working with the same employer partners, and none of them could see what the others had agreed. The Employer Hub gave each partner relationship one home in Salesforce, routed every request to the right department automatically and reported on the results. This page shows the process maps, the live data model behind the hub and a walkthrough of how a partner inquiry moves through it.</p>"
                      },
                      "definition": "community_builder:richTextEditor",
                      "id": "e250f3b0-c8c8-4ac1-a615-5ef76bc17d0e",
                      "type": "component"
                    },
                    {
                      "attributes": {
                        "heading": "Process maps and dashboards",
                        "pillar": "A"
                      },
                      "definition": "c:projectAssetGallery",
                      "id": "26381aff-3de1-4bf9-a7a6-c8368e6ebd23",
                      "type": "component"
                    },
                    {
                      "attributes": {
                        "scope": "employerHub"
                      },
                      "definition": "c:schemaVisualizer",
                      "id": "e6bbf6c3-8053-4e55-af59-19de6891ee7d",
                      "type": "component"
                    },
                    {
                      "attributes": {
                        "imageInfos": "",
                        "richTextValue": "<h2>The walkthrough</h2><ol><li>An employer partner sends an inquiry through the college website or by email.</li><li>The inquiry arrives as a case on the partner's account.</li><li>A coordinator triages it and confirms the partner and the contact.</li><li>The case is routed to the department that owns the request.</li><li>The department creates the outcome: a job posting, a sponsorship or a letter of support.</li><li>The outcome is tracked as an engagement on the partner account, so every department sees the whole relationship.</li><li>Follow-up work stays on the same account instead of in separate inboxes.</li><li>Dashboards report inquiry volume and outcomes by department.</li></ol>"
                      },
                      "definition": "community_builder:richTextEditor",
                      "id": "1a5fbc98-8ae3-4d39-bd7c-7aec6c46ca20",
                      "type": "component"
                    }
                  ],
