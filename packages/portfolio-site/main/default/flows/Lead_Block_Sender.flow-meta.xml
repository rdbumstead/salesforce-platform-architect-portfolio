        <actionType>apex</actionType>
        <connector>
            <targetReference>Blocked</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>leadId</name>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>blockType</name>
            <value>
                <elementReference>Block_Type</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>reason</name>
            <value>
                <elementReference>Reason</elementReference>
            </value>
        </inputParameters>
        <nameSegment>SubmissionBlockAction</nameSegment>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>64.0</apiVersion>
    <choices>
        <name>Choice_Domain</name>
        <choiceText>The whole domain</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Domain</stringValue>
        </value>
    </choices>
    <choices>
        <name>Choice_Email</name>
        <choiceText>This email address</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Email</stringValue>
        </value>
    </choices>
    <decisions>
        <name>Blocked</name>
        <label>Blocked</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <defaultConnector>
            <targetReference>Not_Blocked_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not blocked</defaultConnectorLabel>
        <rules>
            <name>Was_Blocked</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Block_Sender.isSuccess</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Blocked_Screen</targetReference>
            </connector>
            <label>Was blocked</label>
        </rules>
    </decisions>
    <description
  >The Block Sender quick action on Lead (Round 7 plan contract P3). It asks whether to block the Lead's email or its whole domain, calls SubmissionBlockAction to add the block and mark the Lead as spam, and says what happened. Works in the Salesforce mobile app.</description>
    <environments>Default</environments>
    <interviewLabel>Lead Block Sender {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead Block Sender</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
