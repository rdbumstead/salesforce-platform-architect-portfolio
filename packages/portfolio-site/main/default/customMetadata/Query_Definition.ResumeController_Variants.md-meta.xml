  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
>
    <label>ResumeController Variants</label>
    <protected>false</protected>
    <values>
        <field>Object__c</field>
        <value xsi:type="xsd:string">Resume_Variant__c</value>
    </values>
    <values>
        <field>Fields__c</field>
        <value
      xsi:type="xsd:string"
    >Text__c, Title_Family__c, Selection_Priority__c, Variant_Type__c</value>
    </values>
    <values>
        <field>Filter__c</field>
