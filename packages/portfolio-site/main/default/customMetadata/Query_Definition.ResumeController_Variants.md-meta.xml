        <field>Order_By__c</field>
        <value xsi:type="xsd:string">Name ASC</value>
    </values>
    <values>
        <field>Row_Limit__c</field>
        <value xsi:type="xsd:double">50000</value>
    </values>
    <values>
        <field>Access_Mode__c</field>
        <value xsi:type="xsd:string">SYSTEM_MODE</value>
    </values>
    <values>
        <field>Active__c</field>
        <value xsi:type="xsd:boolean">true</value>
    </values>
    <values>
        <field>Description__c</field>
        <value
      xsi:type="xsd:string"
    >Resume summary and headline of one focus, from its public verified Summary and Headline variants.</value>
    </values>
    <values>
        <field>Visitor_Label__c</field>
        <value xsi:type="xsd:string">summaries and headlines</value>
    </values>
