<?xml version="1.0" encoding="UTF-8" ?>
<CustomMetadata
  xmlns="http://soap.sforce.com/2006/04/metadata"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
>
    <label>SAPICertification List</label>
    <protected>false</protected>
    <values>
        <field>Object__c</field>
        <value xsi:type="xsd:string">Certification__c</value>
    </values>
    <values>
        <field>Fields__c</field>
        <value
      xsi:type="xsd:string"
    >Id, Public_Key__c, Name, Contact__c, Contact__r.Name, Contact__r.Public_Key__c, Issuer__c, Issuer__r.Name, Issuer__r.Public_Key__c, Earned_Date__c</value>
    </values>
    <values>
        <field>Filter__c</field>
        <value
      xsi:type="xsd:string"
    >(IsDeleted = :hasContactName OR Contact__r.Name = :contactName) AND (IsDeleted = :hasIssuerName OR Issuer__r.Name = :issuerName) AND (IsDeleted = :hasCertificationName OR Name = :certificationName)</value>
    </values>
    <values>
        <field>Order_By__c</field>
        <value
      xsi:type="xsd:string"
    >Earned_Date__c DESC NULLS LAST, Name ASC</value>
    </values>
    <values>
        <field>Row_Limit__c</field>
        <value xsi:type="xsd:double">50000</value>
    </values>
    <values>
        <field>Access_Mode__c</field>
        <value xsi:type="xsd:string">SYSTEM_MODE</value>
    </values>
    <values>
        <field>Active__c</field>
        <value xsi:type="xsd:boolean">true</value>
    </values>
    <values>
        <field>Description__c</field>
        <value
      xsi:type="xsd:string"
    >GET /sapi/v1/certifications, filtered by contactName, issuerName and certificationName.</value>
    </values>
</CustomMetadata>
