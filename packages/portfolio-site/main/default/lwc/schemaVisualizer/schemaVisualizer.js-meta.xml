<?xml version="1.0" encoding="UTF-8" ?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Schema Visualizer</masterLabel>
    <description
  >Live ERD of the portfolio or Employer Hub schema, drawn from SchemaService, with a scope toggle and an object list.</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property
        name="scope"
        type="String"
        label="Scope"
        description="Schema shown first: employerHub or portfolio."
        datasource="employerHub,portfolio"
        default="employerHub"
      />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
