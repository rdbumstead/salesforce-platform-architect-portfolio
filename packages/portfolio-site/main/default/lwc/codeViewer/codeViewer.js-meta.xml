<?xml version="1.0" encoding="UTF-8" ?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Code Viewer</masterLabel>
    <description>Displays syntax highlighted code</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property
        name="title"
        type="String"
        label="Title"
        default="Source Code"
      />
            <property
        name="code"
        type="String"
        label="Code"
        description="Source code to display"
      />
            <property
        name="language"
        type="String"
        label="Language"
        default="apex"
        description="Prism language name, for example apex, javascript, css or markup"
      />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
