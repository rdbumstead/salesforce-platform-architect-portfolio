<?xml version="1.0" encoding="UTF-8" ?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description
  >Lets the Portfolio Guide Agent's user run its three read only actions. The actions read in system mode, so no object access is granted.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Portfolio Guide Agent Actions</label>
    <classAccesses>
        <apexClass>PortfolioAgentCareer</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>PortfolioAgentCredentials</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>PortfolioAgentProjects</apexClass>
        <enabled>true</enabled>
    </classAccesses>
</PermissionSet>
