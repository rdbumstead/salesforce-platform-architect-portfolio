    <reportType>Site_Usage_History__c</reportType>
    <format>Summary</format>
    <scope>organization</scope>
    <showDetails>false</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>true</showSubTotals>
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>Site.UsageHistory$Usage</field>
    </columns>
    <groupingsDown>
        <dateGranularity>None</dateGranularity>
        <field>Site$Name</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <groupingsDown>
        <dateGranularity>None</dateGranularity>
        <field>Site.UsageHistory$LimitType</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>Site.UsageHistory$UsageDate</field>
        <sortOrder>Desc</sortOrder>
    </groupingsDown>
